# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/velocity-spur?retryWrites=true&w=majority

# Long random string (32+ chars) used to sign admin session cookies
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=

# Public site URL (no trailing slash) - used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.velocityspurhotshot.ca

# New lead notifications (quote requests and inquiries).
# Email is sent to the email in Admin > Settings. For Gmail: turn on 2-Step Verification,
# then create an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=velocityspurshotshot@gmail.com
SMTP_PASS=
# Optional, defaults to Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465

# Optional SMS alerts to the phone in Admin > Settings (Twilio account required)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
